{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the main window needs, and nothing more",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPCONFIG/pictures/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPCONFIG/pictures/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPCONFIG/pictures/**" }]
    }
  ]
}